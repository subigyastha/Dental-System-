generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SuperAdmin
  Owner
  Admin
  Manager
  Receptionist
  Scheduler
  Provider
  Assistant
  Finance
  InventoryManager
  Client
}

enum OrganizationMembershipStatus {
  Active
  Suspended
  Revoked
}

enum RecordStatus {
  Active
  Inactive
  Invited
  Suspended
}

enum ProviderStatus {
  Available
  Busy
  Away
  Inactive
}

enum AppointmentStatus {
  Scheduled
  Confirmed
  CheckedIn
  InProgress
  Completed
  Cancelled
  NoShow
  Rescheduled
  FollowUpRequired
}

enum Priority {
  Low
  Normal
  High
  Urgent
}

enum FollowUpType {
  Reminder
  NoShowRecovery
  Recall
  IncompleteWorkflow
  TreatmentContinuation
}

enum FollowUpStatus {
  Open
  InProgress
  Waiting
  Done
  Blocked
}

enum NotificationChannel {
  SMS
  WhatsApp
  Email
  Push
}

enum NotificationStatus {
  Queued
  Sending
  Delivered
  Failed
  Cancelled
}

enum InvoiceStatus {
  Draft
  Issued
  PartiallyPaid
  Paid
  Cancelled
  Void
}

enum PaymentMethod {
  Cash
  Card
  BankTransfer
  MobileWallet
  Insurance
  Other
}

enum PaymentStatus {
  Pending
  Completed
  Failed
  Refunded
  Voided
}

enum FinancialCorrectionKind {
  InvoiceVoid
  Refund
  Reversal
  PaymentVoid
}

enum FinancialCorrectionStatus {
  PendingApproval
  Executed
  Rejected
}

enum InventoryMovementType {
  OpeningBalance
  Receive
  Consume
  AdjustIncrease
  AdjustDecrease
  TransferOut
  TransferIn
  ReturnToStock
  Quarantine
  ReleaseFromQuarantine
  Waste
  StocktakeReconciliation
}

enum InventoryLotStatus {
  Available
  Quarantined
  Exhausted
  Expired
}

enum SupportAccessGrantStatus {
  Active
  Revoked
  Expired
}

enum ClientIdentityReviewStatus {
  Pending
  InReview
  Resolved
  Dismissed
}

enum ClientIdentityReviewReason {
  PriorVisitClaim
  SkippedPossibleMatches
  ProvisionalClient
  DuplicateSignal
  Other
}

model Organization {
  id                     String                        @id @default(cuid())
  name                   String
  businessType           String                        @default("dental_clinic")
  email                  String?
  phone                  String?
  address                String?
  status                 RecordStatus                  @default(Active)
  timezone               String                        @default("Asia/Kathmandu")
  primaryCalendar        String                        @default("AD")
  locations              Location[]
  users                  User[]
  memberships            OrganizationMembership[]
  providers              Provider[]
  customers              Customer[]
  clientPhones           ClientPhone[]
  clientIdentityReviews  ClientIdentityReview[]
  clientCodeSequence     ClientCodeSequence?
  clientAliases          ClientAlias[]
  clientMerges           ClientMerge[]
  communicationLogs      CommunicationLog[]
  invoiceNumberSequence  InvoiceNumberSequence?
  financialCorrections   FinancialCorrection[]
  inventoryItems         InventoryItem[]
  inventorySuppliers     InventorySupplier[]
  inventoryLots          InventoryLot[]
  inventoryBalances      InventoryStockBalance[]
  inventoryMovements     InventoryMovement[]
  inventoryStocktakes    InventoryStocktake[]
  services               Service[]
  resources              Resource[]
  appointments           Appointment[]
  bookingSlotHolds       BookingSlotHold[]
  bookingConfirmations   BookingConfirmation[]
  clientCreationReceipts ClientCreationReceipt[]
  followUpTasks          FollowUpTask[]
  notifications          Notification[]
  invoices               Invoice[]
  payments               Payment[]
  workflowEvents         WorkflowEvent[]
  auditLogs              AuditLog[]
  featureOverrides       OrganizationFeatureOverride[]
  featureAdoptionEvents  FeatureAdoptionEvent[]
  supportAccessGrants    SupportAccessGrant[]
  settings               OrganizationSetting?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([status])
  @@index([businessType])
}

model Location {
  id                   String                   @id @default(cuid())
  organizationId       String
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  address              String?
  phone                String?
  timezone             String                   @default("Asia/Kathmandu")
  isActive             Boolean                  @default(true)
  resources            Resource[]
  appointments         Appointment[]
  bookingSlotHolds     BookingSlotHold[]
  availability         ProviderAvailability[]
  recurringBlocks      ProviderRecurringBlock[]
  blockedTimes         BlockedTime[]
  providerServices     ProviderService[]
  roleAssignments      RoleAssignment[]
  invoices             Invoice[]
  payments             Payment[]
  financialCorrections FinancialCorrection[]
  inventoryLots        InventoryLot[]
  inventoryBalances    InventoryStockBalance[]
  inventoryMovements   InventoryMovement[]
  inventoryStocktakes  InventoryStocktake[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([organizationId, isActive])
}

model OrganizationSetting {
  id                                    String       @id @default(cuid())
  organizationId                        String       @unique
  organization                          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultBufferMinutes                  Int          @default(10)
  bookingHoldMinutes                    Int          @default(3)
  slotStartIntervalMinutes              Int          @default(15)
  scheduleConfigurationVersion          Int          @default(1)
  reminderLeadMinutes                   Int          @default(1440)
  allowOverlaps                         Boolean      @default(false)
  businessDayStartsAt                   String       @default("08:00")
  businessDayEndsAt                     String       @default("18:00")
  financeCorrectionApprovalThresholdNpr Decimal      @default(0) @db.Decimal(18, 2)
}

model User {
  id                                  String                        @id @default(cuid())
  organizationId                      String?
  organization                        Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                                String
  email                               String
  passwordHash                        String?
  phone                               String?
  staffLabel                          String?
  department                          String?
  employeeCode                        String?
  licenseNumber                       String?
  employmentType                      String?
  startDate                           DateTime?
  emergencyContactName                String?
  emergencyContactPhone               String?
  notes                               String?
  isSchedulable                       Boolean                       @default(false)
  lastLoginAt                         DateTime?
  status                              RecordStatus                  @default(Active)
  role                                UserRole
  provider                            Provider?
  clientProfiles                      Customer[]
  archivedCustomers                   Customer[]                    @relation("CustomerArchivedBy")
  createdClientPhones                 ClientPhone[]                 @relation("ClientPhoneCreatedBy")
  verifiedClientPhones                ClientPhone[]                 @relation("ClientPhoneVerifiedBy")
  archivedClientPhones                ClientPhone[]                 @relation("ClientPhoneArchivedBy")
  createdClientIdentityReviews        ClientIdentityReview[]        @relation("ClientIdentityReviewCreatedBy")
  resolvedClientIdentityReviews       ClientIdentityReview[]        @relation("ClientIdentityReviewResolvedBy")
  archivedClientIdentityReviews       ClientIdentityReview[]        @relation("ClientIdentityReviewArchivedBy")
  sessions                            UserSession[]
  memberships                         OrganizationMembership[]      @relation("OrganizationMembershipSubject")
  grantedMemberships                  OrganizationMembership[]      @relation("OrganizationMembershipGrantedBy")
  revokedMemberships                  OrganizationMembership[]      @relation("OrganizationMembershipRevokedBy")
  grantedRoleAssignments              RoleAssignment[]              @relation("RoleAssignmentGrantedBy")
  revokedRoleAssignments              RoleAssignment[]              @relation("RoleAssignmentRevokedBy")
  auditLogs                           AuditLog[]
  updatedPlatformFeatureFlags         PlatformFeatureFlag[]         @relation("PlatformFeatureFlagUpdatedBy")
  updatedOrganizationFeatureOverrides OrganizationFeatureOverride[] @relation("OrganizationFeatureOverrideUpdatedBy")
  requestedSupportAccessGrants        SupportAccessGrant[]          @relation("SupportAccessRequestedBy")
  revokedSupportAccessGrants          SupportAccessGrant[]          @relation("SupportAccessRevokedBy")
  platformAuditEvents                 PlatformAuditEvent[]
  bookingSlotHolds                    BookingSlotHold[]             @relation("BookingSlotHoldCreatedBy")
  bookingConfirmations                BookingConfirmation[]         @relation("BookingConfirmationActor")
  clientCreationReceipts              ClientCreationReceipt[]       @relation("ClientCreationReceiptActor")
  recordedPayments                    Payment[]                     @relation("PaymentRecordedBy")
  initiatedFinancialCorrections       FinancialCorrection[]         @relation("FinancialCorrectionInitiatedBy")
  approvedFinancialCorrections        FinancialCorrection[]         @relation("FinancialCorrectionApprovedBy")
  rejectedFinancialCorrections        FinancialCorrection[]         @relation("FinancialCorrectionRejectedBy")
  actedClientMerges                   ClientMerge[]                 @relation("ClientMergeActor")
  actedWorkflowEvents                 WorkflowEvent[]               @relation("WorkflowEventActor")
  createdFinanceInvoices              Invoice[]                     @relation("FinanceInvoiceCreatedBy")
  issuedFinanceInvoices               Invoice[]                     @relation("FinanceInvoiceIssuedBy")
  createdInventoryItems               InventoryItem[]               @relation("InventoryItemCreatedBy")
  archivedInventoryItems              InventoryItem[]               @relation("InventoryItemArchivedBy")
  createdInventorySuppliers           InventorySupplier[]           @relation("InventorySupplierCreatedBy")
  archivedInventorySuppliers          InventorySupplier[]           @relation("InventorySupplierArchivedBy")
  postedInventoryMovements            InventoryMovement[]           @relation("InventoryMovementPostedBy")
  createdInventoryStocktakes          InventoryStocktake[]          @relation("InventoryStocktakeCreatedBy")
  createdAt                           DateTime                      @default(now())
  updatedAt                           DateTime                      @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, role])
  @@index([email])
  @@index([status])
}

model PlatformFeatureFlag {
  key             String                        @id
  enabled         Boolean                       @default(false)
  description     String?
  updatedByUserId String?
  updatedBy       User?                         @relation("PlatformFeatureFlagUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedAt       DateTime                      @updatedAt
  createdAt       DateTime                      @default(now())
  overrides       OrganizationFeatureOverride[]

  @@index([enabled])
  @@index([updatedByUserId])
}

model OrganizationFeatureOverride {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  featureKey      String
  feature         PlatformFeatureFlag @relation(fields: [featureKey], references: [key])
  enabled         Boolean
  reason          String
  updatedByUserId String?
  updatedBy       User?               @relation("OrganizationFeatureOverrideUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([organizationId, featureKey])
  @@index([featureKey])
  @@index([updatedByUserId])
}

model FeatureAdoptionEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  featureKey     String
  occurredAt     DateTime     @default(now())

  @@index([featureKey, occurredAt])
  @@index([organizationId, featureKey])
}

model SupportAccessGrant {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id])
  requestedByUserId String
  requestedBy       User                     @relation("SupportAccessRequestedBy", fields: [requestedByUserId], references: [id])
  reason            String
  dataDomains       String[]
  readOnly          Boolean                  @default(true)
  startsAt          DateTime
  expiresAt         DateTime
  status            SupportAccessGrantStatus @default(Active)
  revokedAt         DateTime?
  revokedByUserId   String?
  revokedBy         User?                    @relation("SupportAccessRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revokedReason     String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([organizationId, status, expiresAt])
  @@index([requestedByUserId])
  @@index([revokedByUserId])
}

model PlatformAuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  entityType  String
  entityId    String
  action      String
  payload     Json?
  description String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model OrganizationMembership {
  id              String                       @id @default(cuid())
  organizationId  String
  organization    Organization                 @relation(fields: [organizationId], references: [id])
  userId          String
  user            User                         @relation("OrganizationMembershipSubject", fields: [userId], references: [id])
  status          OrganizationMembershipStatus @default(Active)
  effectiveFrom   DateTime                     @default(now())
  effectiveTo     DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  revokedByUser   User?                        @relation("OrganizationMembershipRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revokedReason   String?
  grantedByUserId String?
  grantedByUser   User?                        @relation("OrganizationMembershipGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantReason     String?
  roleAssignments RoleAssignment[]
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@index([effectiveFrom, effectiveTo])
  @@index([grantedByUserId])
  @@index([revokedByUserId])
}

model RoleAssignment {
  id              String                 @id @default(cuid())
  membershipId    String
  membership      OrganizationMembership @relation(fields: [membershipId], references: [id])
  role            UserRole
  locationId      String?
  location        Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  effectiveFrom   DateTime               @default(now())
  effectiveTo     DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  revokedByUser   User?                  @relation("RoleAssignmentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revokedReason   String?
  grantedByUserId String?
  grantedByUser   User?                  @relation("RoleAssignmentGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantReason     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([membershipId, role])
  @@index([locationId])
  @@index([effectiveFrom, effectiveTo])
  @@index([grantedByUserId])
  @@index([revokedByUserId])
}

model UserSession {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String       @unique
  csrfTokenHash       String
  expiresAt           DateTime
  revokedAt           DateTime?
  revokedReason       String?
  lastSeenAt          DateTime?
  rotatedAt           DateTime?
  replacedBySessionId String?      @unique
  replacedBySession   UserSession? @relation("UserSessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacesSession     UserSession? @relation("UserSessionRotation")
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Provider {
  id                   String                   @id @default(cuid())
  organizationId       String
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String?                  @unique
  user                 User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName          String
  roleLabel            String
  specialty            String?
  status               ProviderStatus           @default(Available)
  color                String                   @default("#0f766e")
  appointments         Appointment[]
  bookingSlotHolds     BookingSlotHold[]
  providerServices     ProviderService[]
  availability         ProviderAvailability[]
  recurringBlocks      ProviderRecurringBlock[]
  blockedTimes         BlockedTime[]
  followUpTasks        FollowUpTask[]           @relation("FollowUpOwner")
  updatedDentalCharts  PatientDentalChart[]     @relation("PatientDentalChartUpdatedBy")
  dentalChartRevisions DentalChartRevision[]    @relation("DentalChartRevisionCreatedBy")
  appointmentSessions  AppointmentSession[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([organizationId, status])
}

model Customer {
  id                      String                  @id @default(cuid())
  organizationId          String
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName                String
  phone                   String
  normalizedPhone         String?
  email                   String?
  normalizedEmail         String?
  userId                  String?
  user                    User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  gender                  String?
  dateOfBirth             DateTime?
  address                 String?
  emergencyContactName    String?
  emergencyContactPhone   String?
  medicalNotes            String?
  allergies               String?
  riskLabel               String                  @default("Routine")
  patientCode             String?
  mergedIntoCustomerId    String?
  mergedIntoCustomer      Customer?               @relation("CustomerMergeTarget", fields: [mergedIntoCustomerId], references: [id], onDelete: Restrict)
  mergedCustomers         Customer[]              @relation("CustomerMergeTarget")
  lastVisitAt             DateTime?
  archivedAt              DateTime?
  archivedByUserId        String?
  archivedByUser          User?                   @relation("CustomerArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  archiveReason           String?
  retentionUntil          DateTime?
  legalHoldAt             DateTime?
  legalHoldReason         String?
  appointments            Appointment[]
  bookingConfirmations    BookingConfirmation[]
  clientCreationReceipts  ClientCreationReceipt[]
  followUpTasks           FollowUpTask[]
  communications          CommunicationLog[]
  appointmentSessions     AppointmentSession[]
  dentalChart             PatientDentalChart?
  dentalChartRevisions    DentalChartRevision[]
  invoices                Invoice[]
  payments                Payment[]
  phones                  ClientPhone[]
  identityReviews         ClientIdentityReview[]  @relation("ClientIdentityReviewSubject")
  resolvedIdentityReviews ClientIdentityReview[]  @relation("ClientIdentityReviewResolution")
  aliases                 ClientAlias[]
  primaryMerges           ClientMerge[]           @relation("ClientMergePrimary")
  secondaryMerges         ClientMerge[]           @relation("ClientMergeSecondary")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([organizationId, patientCode])
  @@index([organizationId, fullName])
  @@index([organizationId, email])
  @@index([organizationId, normalizedPhone])
  @@index([organizationId, normalizedEmail])
  @@index([organizationId, mergedIntoCustomerId])
  @@index([userId])
  @@index([organizationId, archivedAt])
  @@index([retentionUntil])
  @@index([legalHoldAt])
}

model ClientCodeSequence {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nextValue      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ClientCreationReceipt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String
  actor          User         @relation("ClientCreationReceiptActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  idempotencyKey String
  requestHash    String
  customerId     String       @unique
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  response       Json
  createdAt      DateTime     @default(now())

  @@unique([organizationId, actorUserId, idempotencyKey])
  @@index([organizationId, createdAt])
}

model ClientPhone {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId           String
  customer             Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rawValue             String
  normalizedValue      String
  normalizationVersion String       @default("np-v1")
  type                 String       @default("Mobile")
  label                String?
  isPrimary            Boolean      @default(false)
  verificationStatus   String       @default("Unverified")
  verificationSource   String?
  verificationMetadata Json?
  verifiedAt           DateTime?
  verifiedByUserId     String?
  verifiedBy           User?        @relation("ClientPhoneVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  source               String       @default("ManualEntry")
  sourceMetadata       Json?
  createdByUserId      String?
  createdBy            User?        @relation("ClientPhoneCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  archivedAt           DateTime?
  archivedByUserId     String?
  archivedBy           User?        @relation("ClientPhoneArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  archiveReason        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId, normalizedValue])
  @@index([organizationId, archivedAt])
  @@index([customerId, archivedAt])
  @@index([verifiedByUserId])
  @@index([createdByUserId])
  @@index([archivedByUserId])
}

model ClientIdentityReview {
  id                 String                     @id @default(cuid())
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?                  @relation("ClientIdentityReviewSubject", fields: [customerId], references: [id], onDelete: SetNull)
  status             ClientIdentityReviewStatus @default(Pending)
  version            Int                        @default(1)
  reason             ClientIdentityReviewReason
  /// Immutable array of directory-safe candidate snapshots. Each entry keeps
  /// its customerId and score together so audit evidence cannot drift.
  candidateSnapshot  Json                       @default("[]")
  context            Json?
  createdByUserId    String
  createdBy          User                       @relation("ClientIdentityReviewCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resolvedCustomerId String?
  resolvedCustomer   Customer?                  @relation("ClientIdentityReviewResolution", fields: [resolvedCustomerId], references: [id], onDelete: SetNull)
  resolution         String?
  resolutionNotes    String?
  resolutionMetadata Json?
  resolvedAt         DateTime?
  resolvedByUserId   String?
  resolvedBy         User?                      @relation("ClientIdentityReviewResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  archivedAt         DateTime?
  archivedByUserId   String?
  archivedBy         User?                      @relation("ClientIdentityReviewArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  archiveReason      String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([organizationId, reason, createdAt])
  @@index([organizationId, archivedAt])
  @@index([customerId, status])
  @@index([resolvedCustomerId])
  @@index([createdByUserId])
  @@index([resolvedByUserId])
  @@index([archivedByUserId])
}

model ClientAlias {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type           String
  value          String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, type, value])
  @@index([customerId])
}

model ClientMerge {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryCustomerId   String
  primaryCustomer     Customer     @relation("ClientMergePrimary", fields: [primaryCustomerId], references: [id], onDelete: Restrict)
  secondaryCustomerId String
  secondaryCustomer   Customer     @relation("ClientMergeSecondary", fields: [secondaryCustomerId], references: [id], onDelete: Restrict)
  actorUserId         String
  actor               User         @relation("ClientMergeActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  reason              String
  relationshipCounts  Json
  fieldResolution     Json?
  createdAt           DateTime     @default(now())

  @@unique([secondaryCustomerId])
  @@index([organizationId, primaryCustomerId, createdAt])
  @@index([actorUserId])
}

model Service {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  category            String
  description         String?
  durationMinutes     Int
  bufferMinutes       Int                  @default(10)
  price               Decimal?
  isActive            Boolean              @default(true)
  appointments        AppointmentService[]
  providerServices    ProviderService[]
  appointmentSessions AppointmentSession[]
  invoiceLineItems    InvoiceLineItem[]
  bookingSlotHolds    BookingSlotHold[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([organizationId, isActive])
}

model ProviderService {
  id                    String    @id @default(cuid())
  providerId            String
  provider              Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId             String
  service               Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  locationId            String?
  location              Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customDurationMinutes Int?
  customPrice           Decimal?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, serviceId, locationId])
  @@index([serviceId])
  @@index([locationId])
}

model Resource {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name           String
  type           String
  appointments   Appointment[]
  blockedTimes   BlockedTime[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, type])
}

model Appointment {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId          String?
  location            Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id])
  providerId          String
  provider            Provider             @relation(fields: [providerId], references: [id])
  resourceId          String?
  resource            Resource?            @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  services            AppointmentService[]
  startsAt            DateTime
  endsAt              DateTime
  durationMinutes     Int
  bufferMinutes       Int                  @default(10)
  status              AppointmentStatus    @default(Scheduled)
  priority            Priority             @default(Normal)
  communicationState  String               @default("Unconfirmed")
  notes               String?
  cancellationReason  String?
  recurrenceRule      String?
  sourceAppointmentId String?
  sourceAppointment   Appointment?         @relation("AppointmentRecurrence", fields: [sourceAppointmentId], references: [id], onDelete: SetNull)
  childAppointments   Appointment[]        @relation("AppointmentRecurrence")
  followUpTasks       FollowUpTask[]
  communications      CommunicationLog[]
  workflowEvents      WorkflowEvent[]
  session             AppointmentSession?
  notifications       Notification[]
  invoices            Invoice[]
  payments            Payment[]
  bookingConfirmation BookingConfirmation?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([organizationId, startsAt])
  @@index([locationId, startsAt])
  @@index([organizationId, providerId, startsAt])
  @@index([organizationId, customerId, startsAt])
  @@index([organizationId, status, startsAt])
}

model BookingSlotHold {
  id                  String               @id @default(cuid())
  draftId             String
  idempotencyKey      String
  requestHash         String
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId          String
  location            Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  providerId          String
  provider            Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId           String
  service             Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  startsAt            DateTime
  endsAt              DateTime
  bufferMinutes       Int
  expiresAt           DateTime
  releasedAt          DateTime?
  consumedAt          DateTime?
  createdByUserId     String
  createdBy           User                 @relation("BookingSlotHoldCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bookingConfirmation BookingConfirmation?

  @@unique([organizationId, createdByUserId, idempotencyKey])
  @@index([organizationId, providerId, startsAt, expiresAt])
  @@index([organizationId, locationId, expiresAt])
  @@index([createdByUserId, expiresAt])
  @@index([organizationId, createdByUserId, draftId, expiresAt])
}

model BookingConfirmation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String
  actor          User             @relation("BookingConfirmationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  idempotencyKey String
  draftId        String
  requestHash    String
  appointmentId  String           @unique
  appointment    Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  holdId         String?          @unique
  hold           BookingSlotHold? @relation(fields: [holdId], references: [id], onDelete: Restrict)
  response       Json
  createdAt      DateTime         @default(now())

  @@unique([organizationId, actorUserId, idempotencyKey])
  @@index([organizationId, draftId, createdAt])
  @@index([customerId, createdAt])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([appointmentId, serviceId])
}

model ProviderAvailability {
