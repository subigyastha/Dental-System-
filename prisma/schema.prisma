  updatedByProviderId        String?
  updatedByProvider          Provider?           @relation("PatientDentalChartUpdatedBy", fields: [updatedByProviderId], references: [id], onDelete: SetNull)
  sourceAppointmentSessionId String?
  sourceAppointmentSession   AppointmentSession? @relation("PatientDentalChartSourceSession", fields: [sourceAppointmentSessionId], references: [id], onDelete: SetNull)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  @@index([updatedByProviderId])
  @@index([sourceAppointmentSessionId])
}

model DentalChartRevision {
  id                   String              @id @default(cuid())
  customerId           String
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointmentSessionId String?             @unique
  appointmentSession   AppointmentSession? @relation(fields: [appointmentSessionId], references: [id], onDelete: SetNull)
  createdByProviderId  String?
  createdByProvider    Provider?           @relation("DentalChartRevisionCreatedBy", fields: [createdByProviderId], references: [id], onDelete: SetNull)
  chartData            Json
  note                 String?
  createdAt            DateTime            @default(now())

  @@index([customerId, createdAt])
  @@index([createdByProviderId])
}

model FollowUpTask {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  appointmentId  String?
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          Provider?      @relation("FollowUpOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  type           FollowUpType
  status         FollowUpStatus @default(Open)
  priority       Priority       @default(Normal)
  dueAt          DateTime
  summary        String
  nextAction     String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([organizationId, customerId, dueAt])
  @@index([appointmentId])
  @@index([ownerId])
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  channel        NotificationChannel
  status         NotificationStatus  @default(Queued)
  templateKey    String
  recipient      String
  scheduledFor   DateTime
  sentAt         DateTime?
  payload        Json
  error          String?
  createdAt      DateTime            @default(now())

  @@index([organizationId, status, scheduledFor])
}

model Invoice {
  id                  String                @id @default(cuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointmentId       String?
  appointment         Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  locationId          String?
  location            Location?             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  currency            String                @default("NPR")
  createdByUserId     String?
  createdBy           User?                 @relation("FinanceInvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  idempotencyKey      String?
  requestHash         String?
  issuedByUserId      String?
  issuedBy            User?                 @relation("FinanceInvoiceIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  issueIdempotencyKey String?
  issueRequestHash    String?
  invoiceNumber       String
  status              InvoiceStatus         @default(Draft)
  issuedAt            DateTime              @default(now())
  dueAt               DateTime?
  subtotal            Decimal               @default(0)
  discountAmount      Decimal               @default(0)
  taxAmount           Decimal               @default(0)
  totalAmount         Decimal               @default(0)
  balanceAmount       Decimal               @default(0)
  notes               String?
  lineItems           InvoiceLineItem[]
  payments            Payment[]
  corrections         FinancialCorrection[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, createdByUserId, idempotencyKey])
  @@unique([organizationId, issuedByUserId, issueIdempotencyKey])
  @@index([organizationId, status, issuedAt])
  @@index([customerId])
  @@index([customerId, issuedAt])
  @@index([appointmentId])
  @@index([organizationId, locationId, status, issuedAt])
  @@index([organizationId, locationId, issuedAt])
  @@index([organizationId, issuedAt])
}

model InvoiceNumberSequence {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nextValue      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model FinancialCorrection {
  id                String                    @id @default(cuid())
  organizationId    String
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId        String?
  location          Location?                 @relation(fields: [locationId], references: [id], onDelete: Restrict)
  invoiceId         String
  invoice           Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentId         String?
  payment           Payment?                  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  kind              FinancialCorrectionKind
  status            FinancialCorrectionStatus @default(PendingApproval)
  amount            Decimal                   @default(0) @db.Decimal(18, 2)
  currency          String                    @default("NPR")
  reason            String
  initiatedByUserId String
  initiatedBy       User                      @relation("FinancialCorrectionInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  approvedByUserId  String?
  approvedBy        User?                     @relation("FinancialCorrectionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt        DateTime?
  rejectedByUserId  String?
  rejectedBy        User?                     @relation("FinancialCorrectionRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: Restrict)
  rejectedAt        DateTime?
  requestedAt       DateTime                  @default(now())
  executedAt        DateTime?
  version           Int                       @default(1)
  idempotencyKey    String?
  requestHash       String?
  providerReference String?
  metadata          Json?
  createdAt         DateTime                  @default(now())

  @@unique([organizationId, initiatedByUserId, idempotencyKey])
  @@index([organizationId, locationId, status, requestedAt])
  @@index([organizationId, locationId, requestedAt])
  @@index([organizationId, locationId, executedAt])
  @@index([organizationId, executedAt])
  @@index([invoiceId, requestedAt])
  @@index([paymentId])
}

model InvoiceLineItem {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description    String
  quantity       Int      @default(1)
  unitPrice      Decimal  @default(0)
  discountAmount Decimal  @default(0)
  taxAmount      Decimal  @default(0)
  lineTotal      Decimal  @default(0)
  sortOrder      Int      @default(0)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId, sortOrder])
  @@index([serviceId])
}

model Payment {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId       String
  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointmentId    String?
  appointment      Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  locationId       String?
  location         Location?             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  amount           Decimal               @db.Decimal(18, 2)
  currency         String                @default("NPR")
  method           PaymentMethod
  status           PaymentStatus         @default(Completed)
  referenceNumber  String?
  paidAt           DateTime              @default(now())
  notes            String?
  metadata         Json?
  recordedByUserId String?
  recordedBy       User?                 @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  idempotencyKey   String?
  requestHash      String?
  corrections      FinancialCorrection[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([organizationId, recordedByUserId, idempotencyKey])
  @@index([organizationId, paidAt])
  @@index([invoiceId])
  @@index([customerId])
  @@index([appointmentId])
  @@index([organizationId, locationId, paidAt])
}

model CommunicationLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  channel        String
  direction      String
  summary        String
  occurredAt     DateTime     @default(now())
  metadata       Json?

  @@index([organizationId, customerId, occurredAt])
  @@index([appointmentId, occurredAt])
}

model InventorySupplier {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  name             String
  contactName      String?
  phone            String?
  email            String?
  address          String?
  notes            String?
  createdByUserId  String
  createdBy        User                @relation("InventorySupplierCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  archivedAt       DateTime?
  archivedByUserId String?
  archivedBy       User?               @relation("InventorySupplierArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  archiveReason    String?
  preferredItems   InventoryItem[]     @relation("InventoryPreferredSupplier")
  lots             InventoryLot[]
  movements        InventoryMovement[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, archivedAt, name])
}

model InventoryItem {
  id                  String                  @id @default(cuid())
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku                 String
  name                String
  category            String?
  description         String?
  unit                String
  trackLots           Boolean                 @default(false)
  reorderPoint        Decimal                 @default(0) @db.Decimal(18, 3)
  preferredStock      Decimal                 @default(0) @db.Decimal(18, 3)
  preferredSupplierId String?
  preferredSupplier   InventorySupplier?      @relation("InventoryPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: Restrict)
  createdByUserId     String
  createdBy           User                    @relation("InventoryItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  archivedAt          DateTime?
  archivedByUserId    String?
  archivedBy          User?                   @relation("InventoryItemArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  archiveReason       String?
  lots                InventoryLot[]
  balances            InventoryStockBalance[]
  movements           InventoryMovement[]
  stocktakes          InventoryStocktake[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId, archivedAt, name])
  @@index([organizationId, category, archivedAt])
  @@index([preferredSupplierId])
}

model InventoryLot {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           InventoryItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId     String
  location       Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  supplierId     String?
  supplier       InventorySupplier?   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lotNumber      String
  receivedAt     DateTime
  expiresAt      DateTime?
  status         InventoryLotStatus   @default(Available)
  quantityOnHand Decimal              @default(0) @db.Decimal(18, 3)
  version        Int                  @default(1)
  movements      InventoryMovement[]
  stocktakes     InventoryStocktake[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, itemId, locationId, lotNumber])
  @@index([organizationId, locationId, status, expiresAt])
  @@index([organizationId, itemId, locationId])
  @@index([supplierId])
}

model InventoryStockBalance {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId     String
  location       Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantityOnHand Decimal       @default(0) @db.Decimal(18, 3)
  version        Int           @default(1)
  lastMovementAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, itemId, locationId])
  @@index([organizationId, locationId, quantityOnHand])
  @@index([organizationId, itemId])
}

model InventoryMovement {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId           String
  item             InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId       String
  location         Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lotId            String?
  lot              InventoryLot?         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  supplierId       String?
  supplier         InventorySupplier?    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  type             InventoryMovementType
  quantityDelta    Decimal               @db.Decimal(18, 3)
  balanceBefore    Decimal               @db.Decimal(18, 3)
  balanceAfter     Decimal               @db.Decimal(18, 3)
  lotBalanceBefore Decimal?              @db.Decimal(18, 3)
  lotBalanceAfter  Decimal?              @db.Decimal(18, 3)
  transferGroupId  String?
  sourceReference  String?
  reason           String
  occurredAt       DateTime              @default(now())
  postedByUserId   String
  postedBy         User                  @relation("InventoryMovementPostedBy", fields: [postedByUserId], references: [id], onDelete: Restrict)
  idempotencyKey   String
  sequence         Int                   @default(0)
  requestHash      String
  metadata         Json?
  stocktake        InventoryStocktake?
  createdAt        DateTime              @default(now())

  @@unique([organizationId, postedByUserId, idempotencyKey, sequence])
  @@index([organizationId, locationId, occurredAt])
  @@index([organizationId, itemId, occurredAt])
  @@index([organizationId, transferGroupId])
  @@index([lotId, occurredAt])
  @@index([supplierId])
}

model InventoryStocktake {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId           String
  item             InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId       String
  location         Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lotId            String?
  lot              InventoryLot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  systemQuantity   Decimal            @db.Decimal(18, 3)
  countedQuantity  Decimal            @db.Decimal(18, 3)
  varianceQuantity Decimal            @db.Decimal(18, 3)
  reason           String
  countedAt        DateTime
  movementId       String?            @unique
  movement         InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)
  createdByUserId  String
  createdBy        User               @relation("InventoryStocktakeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  idempotencyKey   String
  requestHash      String
  createdAt        DateTime           @default(now())

  @@unique([organizationId, createdByUserId, idempotencyKey])
  @@index([organizationId, locationId, countedAt])
  @@index([organizationId, itemId, countedAt])
  @@index([lotId])
  @@index([createdByUserId])
}

model WorkflowEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointmentId  String
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus     String?
  toStatus       String
  actorUserId    String?
  actor          User?        @relation("WorkflowEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, appointmentId, createdAt])
  @@index([actorUserId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entityType     String
  entityId       String
  action         String
  oldValue       Json?
  newValue       Json?
  description    String?
  createdAt      DateTime     @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}
