  dayOfWeek      Int
  startsAtLocal  String
  endsAtLocal    String
  reason         String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, providerId, dayOfWeek, isActive])
  @@index([locationId])
}

model BlockedTime {
  id             String    @id @default(cuid())
  organizationId String
  providerId     String?
  provider       Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resourceId     String?
  resource       Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  reason         String

  @@index([organizationId, startsAt, endsAt])
  @@index([organizationId, providerId, startsAt, endsAt])
}

model AppointmentSession {
  id                  String               @id @default(cuid())
  appointmentId       String               @unique
  appointment         Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId          String
  provider            Provider             @relation(fields: [providerId], references: [id], onDelete: Restrict)
  serviceId           String
  service             Service              @relation(fields: [serviceId], references: [id])
  visitSummary        String?
  symptoms            String?
  clinicalNotes       String?
  doctorNotes         String?
  followUpRequired    Boolean              @default(false)
  followUpDate        DateTime?
  dentalChartUpdated  Boolean              @default(false)
  chartNote           String?
  dentalChartRevision DentalChartRevision?
  sourceDentalCharts  PatientDentalChart[] @relation("PatientDentalChartSourceSession")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([customerId])
  @@index([providerId])
  @@index([serviceId])
}

model PatientDentalChart {
  id                         String              @id @default(cuid())
  customerId                 String              @unique
  customer                   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  chartData                  Json
