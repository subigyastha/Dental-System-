{
  "name": "workflow-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w web",
    "build:api": "npm run build -w api",
    "start": "npm run start -w web",
    "start:api": "npm run start -w api",
    "test:calendar": "npm run test:calendar -w web",
    "test": "npm run test:calendar && npm run test:workspace-boundary -w web && npm run test:api-client -w web && npm run test:tenancy -w api && npm run test:auth -w api && npm run test:phase-one-http -w api",
    "lint": "npm run lint -w web",
    "format:check": "node scripts/check-format.mjs",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w api",
    "check:web-prisma-boundary": "node scripts/check-no-web-prisma.mjs",
    "check:route-inventory": "node scripts/check-nest-route-inventory.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:validate": "prisma validate && prisma migrate status",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:rehearse": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearse-prisma-migrations.ps1",
    "db:migrate:resolve": "prisma migrate resolve",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
