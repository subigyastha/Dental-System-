# Local Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workflow_system?schema=public"

# Supabase (examples — copy from Dashboard → Settings → Database)
# Direct (migrations / prisma db push). Use sslmode=require:
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres?schema=public&sslmode=require"
# Persistent Nest API on IPv4/firewall-constrained networks: use Supavisor
# Transaction Mode (6543). The API adds pgbouncer=true and a bounded pool.
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
# Five connections is the default for one persistent Nest process. Lower this
# per instance when enough replicas could exceed the Supabase project pool.
# PRISMA_CONNECTION_LIMIT=5
# Set `session` only when the pooler 5432 endpoint is reliably reachable:
# SUPABASE_POOL_MODE="session"
# Prisma migrate uses DIRECT_URL. Prefer the direct URL when IPv6 is available:
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:5432/postgres?schema=public&sslmode=require"
# On IPv4-only networks, use the Supavisor Session Mode URL (port 5432):
# DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Optional: Prisma connect retries on startup (API only)
# DATABASE_CONNECT_RETRIES=5
# DATABASE_CONNECT_RETRY_MS=2500

API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
AUTH_SECRET="replace-with-a-long-random-secret"
# Required in production: configure CORS to the exact browser origin(s).
# CORS_ORIGINS="https://app.example.com"
# Session lifetime: absolute 8 hours and inactivity timeout 30 minutes by default.
# SESSION_TTL_SECONDS=28800
# SESSION_IDLE_TIMEOUT_SECONDS=1800
# Persist activity at most once per session in this interval. Session validity
# is still checked on every request; this removes redundant database writes.
# SESSION_TOUCH_INTERVAL_SECONDS=300
# Demo data is deliberately opt-in and requires a unique password at execution time:
# $env:ALLOW_DEMO_SEED="true"; $env:DEMO_SEED_PASSWORD="use-a-unique-15-character-minimum-passphrase"; npm.cmd run db:seed

# One-time platform administrator bootstrap. Set these only for the provisioning
# command, then remove them from the shell environment:
# $env:ALLOW_PLATFORM_ADMIN_PROVISION="true"
# $env:PLATFORM_ADMIN_NAME="Platform Administrator"
# $env:PLATFORM_ADMIN_EMAIL="platform-admin@example.com"
# $env:PLATFORM_ADMIN_PASSWORD="use-a-unique-15-character-minimum-passphrase"
# npm.cmd run platform:admin:provision
