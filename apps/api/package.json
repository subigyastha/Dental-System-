{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:tenancy": "node --import tsx --test src/modules/customers/customers.tenancy.spec.ts",
    "test:auth": "node --import tsx --test src/http-security.spec.ts src/modules/auth/session-auth.guard.spec.ts src/modules/auth/csrf.guard.spec.ts src/modules/auth/phase-one-tenancy.spec.ts src/modules/auth/server-sessions.spec.ts src/modules/auth/request-session.spec.ts",
    "test:phase-one-http": "node --import tsx --test src/integration/phase-one-http.integration.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3",
    "tsx": "^4.21.0"
  }
}
